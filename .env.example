DEPLOYER_PRIVATE_KEY=0x
OWNER=0x                       # multisig recommended; defaults to deployer. Must be identical on every chain (CREATE3 factory address)
TREASURY=0x                    # protocol fee recipient, defaults to OWNER
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<key>
BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/<key>
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/<key>
